function fiscalStart(d=new Date()){ return d.getMonth()>=10?d.getFullYear():d.getFullYear()-1; }
function statsTable(){
  const fy=fiscalStart(); const cur=Array(12).fill(0), prev=Array(12).fill(0);
  for(const m of S.moves){ if(m.type!=="out") continue; const d=new Date(m.date+"T00:00:00"); const y=fiscalStart(d); const idx=(d.getMonth()+2)%12;
    if(y===fy) cur[idx]+=m.qty; else if(y===fy-1) prev[idx]+=m.qty; }
  const sum=a=>a.reduce((s,x)=>s+x,0);
  return `<table><thead><tr><th>MOIS</th><th class="n">${fy-1}/${fy}</th><th class="n">${fy}/${fy+1}</th><th class="n">VENTES TTL</th></tr></thead><tbody>
   ${MONTHS.map((n,i)=>`<tr><td>${n}</td><td class="n">${fmt(prev[i])}</td><td class="n">${fmt(cur[i])}</td><td class="n">${fmt(prev[i]+cur[i])}</td></tr>`).join("")}</tbody>
   <tfoot><tr><td>TOTAL</td><td class="n">${fmt(sum(prev))}</td><td class="n">${fmt(sum(cur))}</td><td class="n">${fmt(sum(prev)+sum(cur))}</td></tr></tfoot></table>`;
}
