  minus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14"/></svg>',
  moon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg>',
  x:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>'
};

const S = { user:null, items:[], ateliers:[], dests:[], moves:[], logs:[], view:"dash", q:"", modalOpen:false, pending:false, filter:{code:"",dest:"",type:""}, page:0 };

function applyTheme(t){ document.documentElement.dataset.theme=t; localStorage.setItem("ferma_theme",t); }
applyTheme(localStorage.getItem("ferma_theme") || (matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"));

async function fetchAll(table, order){
  const out=[]; const size=1000;
  for(let from=0;;from+=size){
    const {data,error} = await sb.from(table).select("*").order(order.col,{ascending:order.asc}).order("id",{ascending:true, nullsFirst:true}).range(from,from+size-1);
    if(error) throw error; out.push(...data); if(data.length<size) break;
  }
  return out;
}
async function loadAll(){
  try{
    const [items, ateliers, dests, moves] = await Promise.all([
      sb.from("items").select("*").order("name").then(r=>{if(r.error)throw r.error;return r.data}),
      sb.from("ateliers").select("*").order("name").then(r=>{if(r.error)throw r.error;return r.data}),
      sb.from("dests").select("*").order("name").then(r=>{if(r.error)throw r.error;return r.data}),
      fetchAll("moves",{col:"date",asc:true})
    ]);
    const lg = await sb.from("logs").select("*").order("at",{ascending:false}).limit(200);
    Object.assign(S,{items,ateliers,dests,moves,logs:lg.data||[]});
    compute(); render();
  }catch(e){ toast(dbErr(e),"err"); }
}

let C = {};
function compute(){
  const by = {}; S.items.forEach(i=>by[i.code]={in:0,out:0,stock:0,perDest:{},out365:0,out90:0,count:0,last:null});
  const sorted=[...S.moves].sort((a,b)=>a.date.localeCompare(b.date)||String(a.ts||"").localeCompare(String(a.ts||""))||a.id-b.id);
  const now=new Date(), d365=new Date(now-365*864e5).toISOString().slice(0,10), d90=new Date(now-90*864e5).toISOString().slice(0,10);
  for(const m of sorted){
    const a=by[m.code]; if(!a) continue;
    if(m.type==="in"){a.in+=m.qty;a.stock+=m.qty}else{
      a.out+=m.qty;a.stock-=m.qty;a.perDest[m.dest]=(a.perDest[m.dest]||0)+m.qty;
      if(m.date>=d365)a.out365+=m.qty; if(m.date>=d90)a.out90+=m.qty; a.count++;
    }
    m.solde=a.stock; a.last=m.date;
  }
  for(const i of S.items){
    const a=by[i.code]; a.perMonth=a.out365/12; a.nbMois=a.perMonth>0?a.stock/a.perMonth:null;
    a.daysLeft=a.out90>0?Math.floor(a.stock/(a.out90/90)):null;
    a.status=a.stock<=0?"SALAT":(a.daysLeft!==null && a.daysLeft<=30)?"QARB YSALI":"NORMAL";
    a.suggest=Math.max(0, Math.ceil(a.perMonth*2 - a.stock));
  }
  C={by,sorted};
}
const destName = id => (S.dests.find(d=>d.id===id)||{}).name || "—";
const itemOf = c => S.items.find(i=>i.code===c);
function statusBadge(s){ return s==="SALAT"?'<span class="badge b-bad">● SALAT</span>':s==="QARB YSALI"?'<span class="badge b-warn">● QARB YSALI</span>':'<span class="badge b-ok">● NORMAL</span>'; }

function subscribe(){
  sb.channel("ferma").on("postgres_changes",{event:"*",schema:"public"},()=>{
    if(S.modalOpen){ if(!S.pending){S.pending=true; showBanner();} return; }
    debounceReload();
  }).subscribe();
}
let rt; function debounceReload(){ clearTimeout(rt); rt=setTimeout(loadAll,300); }
function showBanner(){ let b=$("#banner"); if(!b){b=document.createElement("div");b.id="banner";b.className="banner";document.body.appendChild(b);} b.textContent=M.pending; }
function flushPending(){ $("#banner")?.remove(); if(S.pending){S.pending=false; loadAll(); toast(M.refreshed,"info");} }

