function openModal(title, body, footer, bind){
  S.modalOpen=true; const s=document.createElement("div"); s.className="scrim"; s.id="scrim";
  s.innerHTML=`<div class="modal" role="dialog" aria-modal="true" aria-label="${esc(title)}"><header><h3>${title}</h3><button class="btn ghost sm" id="mx" aria-label="Fermer">${ICON.x}</button></header><div class="body">${body}</div>${footer?`<footer>${footer}</footer>`:""}</div>`;
  document.body.appendChild(s); $("#mx").onclick=closeModal; s.onclick=e=>{if(e.target===s)closeModal()};
  s.onkeydown=e=>{if(e.key==="Escape")closeModal()}; bind&&bind(s); setTimeout(()=>s.querySelector("[autofocus]")?.focus()||s.querySelector("input,select,button")?.focus(),30);
}
function closeModal(){ $("#scrim")?.remove(); S.modalOpen=false; flushPending(); }
function twoClick(btn, fn){ let armed=false,t; btn.onclick=e=>{e.stopPropagation(); if(!armed){armed=true;btn.classList.add("armed");const o=btn.textContent;btn.textContent="Confirmer ?";toast(M.confirm,"info");t=setTimeout(()=>{armed=false;btn.classList.remove("armed");btn.textContent=o},3000);return} clearTimeout(t); fn();}; }

function doPrint(html){ $("#printArea").innerHTML=html; setTimeout(()=>window.print(),50); }
function printBon(m){ if(!m) return; const i=itemOf(m.code)||{name:m.code,unit:""};
  doPrint(`<div class="ph"><b>Groupe FERMA</b> — Société : FERMA<br><span style="font-size:18px"><b>BON DE SORTIE N° ${String(m.id).padStart(6,"0")}</b></span></div>
   <table><tbody><tr><th>Date</th><td>${frDate(m.date)}</td></tr>${m.type==="in"?`<tr><th>Fournisseur</th><td>${esc(m.supplier||"")}</td></tr>`:`<tr><th>Destination</th><td>${esc(m.dest?destName(m.dest):"—")}</td></tr><tr><th>Remis à</th><td>${esc(m.recipient||"")}</td></tr><tr><th>Matricule</th><td>${esc(m.worker||"—")}</td></tr>`}
   <tr><th>Article</th><td>${esc(i.name)}</td></tr><tr><th>Quantité</th><td><b>${fmt(m.qty)} ${esc(i.unit)}</b></td></tr><tr><th>Reste en stock</th><td>${fmt(C.by[m.code]?.stock??0)}</td></tr>${m.note?`<tr><th>Note</th><td>${esc(m.note)}</td></tr>`:""}</tbody></table>
   <div style="display:flex;justify-content:space-between;margin-top:50px"><div>Signature magasinier</div><div>Signature employé</div></div>`); }
function printLabel(i){ const url=location.origin+location.pathname+"#item="+encodeURIComponent(i.code);
  doPrint(`<div style="border:2px solid #000;padding:14px;width:70mm;text-align:center"><b style="font-size:16px">${esc(i.name)}</b><br><span style="font-family:monospace;font-size:20px">${esc(i.code)}</span><br>
   <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(url)}" style="width:40mm;height:40mm;margin-top:8px" alt="QR"><br><small>FERMA · ${esc(i.category)}</small></div>`); }
function csvCell(v){ v=String(v??""); return /[;"\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v; }
function exportCSV(){
  const L=[["Groupe FERMA"],["Société : FERMA"],["Etat Récapitulatif du Stock : ALUMINIUM"],["Date",new Date().toLocaleDateString("fr-FR")],[],
    ["CODE","ARTICLE","CATEGORIE","UNITE","STOCK","TOTAL ENTREES","TOTAL SORTIES","SORTIES / AN","SORTIES / MOIS","STOCK (nb-mois)","ETAT",...S.dests.map(d=>"SORTIE "+d.name)]];
  S.items.forEach(i=>{const a=C.by[i.code]; L.push([i.name,i.category,i.unit,a.stock,a.in,a.out,a.out365,a.perMonth.toFixed(1),a.nbMois==null?"":a.nbMois.toFixed(1),a.status,...S.dests.map(d=>a.perDest[d.id]||0)])});
  L.push([],["HISTORIQUE DES MOUVEMENTS"],["DATE","CODE","ARTICLE","OPERATION","MOTIF","ENTREE","SORTIE","SOLDE","FOURNISSEUR","DESTINATION","REMIS A","MATRICULE","NOTE","SAISI PAR"]);
  C.sorted.forEach(m=>L.push([m.date,m.code,(itemOf(m.code)||{}).name,m.type==="in"?"ENTREE":"SORTIE",KINDS[m.kind]||"",m.type==="in"?m.qty:"",m.type==="out"?m.qty:"",m.solde,m.supplier||"",m.type==="out"&&m.dest?destName(m.dest):"",m.recipient||"",m.worker||"",m.note||"",m.author||""]));
  const blob=new Blob(["\ufeff"+L.map(r=>r.map(csvCell).join(";")).join("\r\n")],{type:"text/csv;charset=utf-8"});
  const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=`FERMA_stock_${today()}.csv`; a.click();
}
function openWA(text){ window.open("https://wa.me/?text="+encodeURIComponent(text),"_blank","noopener"); }
function shareSummary(){
  const t=today(); const outs=S.moves.filter(m=>m.type==="out"&&m.date===t); const per={}; outs.forEach(m=>{const k=destName(m.dest);per[k]=(per[k]||0)+m.qty});
  const al=S.items.filter(i=>C.by[i.code].status!=="NORMAL");
  openWA(`*FERMA – Magasin* ${new Date().toLocaleDateString("fr-FR")}\nSorties du jour : ${outs.reduce((s,m)=>s+m.qty,0)} (${outs.length} mouvements)\n${Object.entries(per).map(([k,v])=>`• ${k} : ${v}`).join("\n")||"• aucune"}\n\n⚠ En alerte : ${al.length}\n${al.map(i=>`• ${i.name} : ${C.by[i.code].stock} (${C.by[i.code].status})`).join("\n")}`);
}

async function ensureInvDest(){ if(!invDest()){ await sb.from("dests").upsert({name:"Écart inventaire"},{onConflict:"name",ignoreDuplicates:true}); } }
const _load=loadAll; loadAll=async()=>{ await _load(); if(S.user&&S.dests.length&&!invDest()){ await ensureInvDest(); await _load(); } openFromHash(); };
function openFromHash(){ const m=location.hash.match(/^#item=(.+)$/); if(m&&itemOf(decodeURIComponent(m[1]))){ S.cur=decodeURIComponent(m[1]); history.replaceState(null,"",location.pathname); go("item"); } }

boot();
</script>
