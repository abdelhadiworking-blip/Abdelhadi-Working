};

const $ = (s, el=document) => el.querySelector(s);
const esc = v => String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = n => (Math.round(n*10)/10).toLocaleString("fr-FR");
const today = () => new Date().toISOString().slice(0,10);
const frDate = d => d ? new Date(d+"T00:00:00").toLocaleDateString("fr-FR") : "";
function toast(msg, kind="ok"){ const t=document.createElement("div"); t.className="toast "+kind; t.textContent=msg; $("#toasts").appendChild(t); setTimeout(()=>t.remove(), 3800); }
function dbErr(e){
  const m = (e && (e.message||e.details||"")) + "";
  if (m.includes("STOCK_NEGATIF")) return M.overStock;
  if (m.includes("duplicate key") && m.includes("items")) return M.dupCode;
  if (m.includes("duplicate key") && m.includes("dests")) return M.dupDest;
  if (m.includes("violates foreign key") && m.includes("dest")) return M.destUsed;
  if (m.includes("moves_out_needs_worker_dest")) return M.needMat;
  if (m.includes("Invalid login")) return M.login;
  return M.net + (m ? " ("+m.slice(0,80)+")" : "");
}
const isPosInt = v => /^\d+$/.test(String(v).trim()) && +v > 0;
const ICON = {
  dash:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>',
  box:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>',
  swap:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 4v16M3 8l4-4 4 4M17 20V4M21 16l-4 4-4-4"/></svg>',
