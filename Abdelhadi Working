const UNITS = ["pièce","barre","boîte","mètre","m²","kg","rouleau","paquet","litre"];

const M = {
  saved:"تسجل بنجاح ✔", deleted:"تمسح بنجاح ✔", updated:"تبدل بنجاح ✔",
  overStock:"الكمية كتر من الستوك لي كاين", needMat:"رقم MATRICULE ضروري فالخروج",
  needDest:"خاصك تختار فين غادية السلعة", badQty:"الكمية خاصها تكون عدد صحيح موجب",
  needDate:"التاريخ ضروري", needItem:"خاصك تختار السلعة", needName:"سمية السلعة ضرورية",
  badCode:"الكود خاصو غير حروف، أرقام و - . _", dupCode:"هاد الكود ديجا كاين",
