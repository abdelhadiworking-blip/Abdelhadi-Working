    <div class="field"><label for="mrecipient">Remis à / تسلّمها *</label><input class="input" id="mrecipient" value="${esc(mv.recipient||"")}" autocomplete="off" placeholder="Nom du responsable" list="recipientl"><datalist id="recipientl">${[...new Set(S.moves.map(m=>m.recipient).filter(Boolean))].slice(-50).map(w=>`<option value="${esc(w)}">`).join("")}</datalist></div>
