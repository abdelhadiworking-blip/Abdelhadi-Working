  `<p class="muted">Saisissez la quantité comptée sur l'étagère. Les écarts sont enregistrés automatiquement comme « Ajustement inventaire ». Laissez vide pour ignorer.</p>`+
  (S.items.length?`<div class="tbl-wrap"><table><thead><tr><th>Article</th><th class="n">Stock système</th><th class="n">Compté</th><th class="n">Écart</th></tr></thead><tbody>
   ${S.items.map(i=>`<tr><td>${esc(i.name)}</td><td class="n">${fmt(C.by[i.code].stock)}</td><td class="n"><input class="input" inputmode="numeric" data-inv="${esc(i.code)}" style="width:100px;text-align:right"></td><td class="n" id="gap-${esc(i.code)}">—</td></tr>`).join("")}</tbody></table></div>`:`<div class="card empty">Aucun article.</div>`);
  document.querySelectorAll("[data-inv]").forEach(inp=>inp.oninput=()=>{const c=inp.dataset.inv,v=inp.value.trim(); const g=document.getElementById("gap-"+c); if(v===""){g.textContent="—";return} const d=+v-C.by[c].stock; g.innerHTML=isNaN(d)?"?":`<b style="color:${d<0?"var(--bad)":d>0?"var(--ok)":"inherit"}">${d>0?"+":""}${d}</b>`});
  $("#saveInv").onclick=async()=>{
    const rows=[]; for(const inp of document.querySelectorAll("[data-inv]")){ const v=inp.value.trim(); if(v==="") continue; if(!/^\d+$/.test(v)) return toast(M.badQty,"err");
      const d=+v-C.by[inp.dataset.inv].stock; if(d) rows.push({code:inp.dataset.inv,type:d>0?"in":"out",qty:Math.abs(d),date:today(),kind:"inventaire",note:"Inventaire: compté "+v,worker:d<0?"INVENTAIRE":null,dest:d<0?invDest():null}); }
    if(!rows.length) return toast(M.nothing,"info");
    if(rows.some(r=>r.type==="out"&&!r.dest)) return toast(M.needDest,"err");
    const {error}=await sb.from("moves").insert(rows); if(error) return toast(dbErr(error),"err"); toast(M.invDone); loadAll();
  };
}
function invDest(){ return (S.dests.find(d=>d.name==="Écart inventaire")||{}).id; }

