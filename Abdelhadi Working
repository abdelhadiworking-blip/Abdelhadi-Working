  ${S.items.map(i=>{const a=C.by[i.code];return `<tr><td>${esc(i.name)}</td><td class="n">${fmt(a.stock)}</td><td class="n">${fmt(a.out365)}</td><td class="n">${fmt(a.perMonth)}</td><td class="n">${a.nbMois==null?"—":fmt(a.nbMois)}</td><td>${statusBadge(a.status)}</td></tr>`}).join("")}</tbody></table>`;
}
